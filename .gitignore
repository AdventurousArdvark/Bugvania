# ==========================================================================

# Godot 4 .gitignore

# ==========================================================================

 

# Godot 4's auto-generated import/cache folder. NEVER commit this — it is

# rebuilt automatically on open, it's large, and committing it causes constant

# noisy diffs and merge conflicts. This is the single most important line here.

.godot/

 

# Legacy Godot 3 import folder (harmless to keep listed if you ever open old assets)

.import/

 

# ==========================================================================

# Export output

# ==========================================================================

# Built binaries / packaged games. These are artifacts you rebuild, not source.

export.cfg

build/

builds/

exports/

*.exe

*.pck

*.zip

*.dmg

*.apk

*.aab

 

# Android build template (generated by Godot when you set up Android export)

/android/

 

# ==========================================================================

# export_presets.cfg — JUDGMENT CALL (read before deciding)

# ==========================================================================

# This file stores your export configuration. Two valid choices:

#   - IGNORE it (default below) if the file will hold signing secrets such as

#     an Android keystore path/password — you don't want those in git.

#   - COMMIT it (delete the line below) if you keep secrets out of it and want

#     the team to share one export setup. For a solo commercial project, many

#     devs commit it and keep keystores/passwords in a separate untracked file.

export_presets.cfg

 

# ==========================================================================

# C# / Mono (only relevant if you add C# scripts later)

# ==========================================================================

.mono/

data_*/

mono_crash.*.json

*.csproj

*.sln

 

# ==========================================================================

# OS + editor junk

# ==========================================================================

.DS_Store

Thumbs.db

desktop.ini

*~

*.swp

.vscode/

.idea/
